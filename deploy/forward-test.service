[Unit]
Description=JM Forward-test momentum (paper trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worff
WorkingDirectory=/home/worff/trading_bot
ExecStart=/home/worff/trading_bot/venv/bin/python /home/worff/trading_bot/forward_test.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
